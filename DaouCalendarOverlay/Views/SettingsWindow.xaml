<Window x:Class="DaouCalendarOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daou Calendar Overlay 설정"
        Width="650" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DaouOffice 연결" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ValidationNoticeText" Visibility="Collapsed" Foreground="#FFC0392B"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DaouOffice 주소" VerticalAlignment="Center"/>
            <TextBox x:Name="BaseUrlTextBox" Grid.Column="1" Padding="7" ToolTip="예: https://회사이름.daouoffice.com (https 와 *.daouoffice.com 주소만 사용할 수 있습니다)"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="캘린더 ID" VerticalAlignment="Top" Padding="0,7,0,0"/>
            <TextBox x:Name="CalendarIdsTextBox" Grid.Column="1" Height="92" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     Padding="7" ToolTip="한 줄에 하나 또는 쉼표로 구분"/>
        </Grid>

        <Border Grid.Row="3" Background="#FFF5F7FA" CornerRadius="6" Padding="10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Network에서 찾은 /gw/api/calendar/event?... URL을 붙여넣으면 주소와 calendarIds[]를 자동 추출합니다."
                           Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,7"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ApiUrlTextBox" Padding="7" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="URL에서 추출" Padding="12,6" Click="Extract_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="자동 새로고침" VerticalAlignment="Center"/>
            <TextBox x:Name="RefreshMinutesTextBox" Grid.Column="1" Padding="7"/>
            <TextBlock Grid.Column="2" Text="분 (최소 1분)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,0,0,12">
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Windows 로그인 시 자동 실행" Margin="0,4"/>
            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="항상 위에 표시" Margin="0,4"/>
            <CheckBox x:Name="PositionLockedCheckBox" Content="오버레이 위치 잠금" Margin="0,4"/>
        </StackPanel>

        <Border Grid.Row="6" BorderBrush="#FFD8DEE8" BorderThickness="1" CornerRadius="7" Padding="12" VerticalAlignment="Top" Background="#FFF8FAFD">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Chrome 세션 브리지" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Grid.Row="1" Margin="0,8,0,10" Foreground="#667085" TextWrapping="Wrap"
                           Text="오버레이는 별도 로그인을 만들지 않습니다. Chrome 확장이 현재 Chrome 프로필의 DaouOffice 세션을 읽고, Chrome Native Messaging으로 오버레이에 전달해 일정 API를 조회합니다. DaouOffice 탭은 닫아도 되며, Chrome 프로세스가 실행 중인 동안 주기적으로 동기화합니다. 캘린더별 표시 On/Off는 오버레이 우클릭 메뉴에서 변경할 수 있습니다."/>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Chrome 확장 폴더 열기" Padding="12,6" Click="OpenExtensionFolder_Click"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#777" Text="chrome://extensions → 개발자 모드 → 압축해제된 확장 프로그램 로드"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Width="90" Margin="0,0,8,0" Padding="8" Click="Cancel_Click"/>
            <Button Content="저장" Width="100" Padding="8" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
