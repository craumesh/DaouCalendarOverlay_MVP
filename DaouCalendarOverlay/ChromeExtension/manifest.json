{
  "manifest_version": 3,
  "name": "Daou Calendar Overlay Bridge",
  "version": "7.1.0",
  "minimum_chrome_version": "120",
  "description": "Native Messaging bridge for Daou Calendar Overlay. Reuses the existing Chrome DaouOffice session without localhost networking.",
  "key": "",
  "permissions": [
    "alarms",
    "background",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.daouoffice.com/*"
  ],
  "background": {
    "service_worker": "service-worker-v710.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Daou Calendar Overlay Bridge"
  }
}
